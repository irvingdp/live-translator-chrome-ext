{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": ["vitest/globals", "chrome"]
  },
  // site/ and video/ are separate packages, and Playwright compiles e2e/ itself.
  "exclude": ["**/node_modules", "output", "site", "video", "e2e", "playwright.config.ts"]
}
