{
  "name": "bilingual-live-captions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && npm run verify:manifest",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:providers": "REQUIRE_LIVE_PROVIDER_KEYS=1 vitest run tests/providers/deepl.live.test.ts",
    "e2e": "playwright test",
    "zip": "wxt zip",
    "screenshots": "node scripts/store-screenshots.mjs",
    "release": "npm run compile && npm test && npm run zip && npm run verify:manifest",
    "verify:manifest": "node scripts/verify-manifest.mjs output/chrome-mv3/manifest.json"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  }
}
